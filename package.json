{
  "name": "@thepadhiar/ui-components",
  "version": "1.0.0",
  "description": "Enterprise-grade React 19 + TypeScript UI components styled with Tailwind CSS v4 — buttons, form inputs, modals, avatars, a full-featured DataTable, and Formik bindings.",
  "keywords": [
    "react",
    "react-components",
    "ui",
    "ui-components",
    "component-library",
    "tailwindcss",
    "tailwind",
    "typescript",
    "formik",
    "datatable",
    "modal",
    "select",
    "datepicker",
    "enterprise"
  ],
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "COMPONENTS.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "formik": "^2.4.0",
    "lucide-react": ">=1.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "formik": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "formik": "^2.4.9",
    "globals": "^17.11.0",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  }
}
